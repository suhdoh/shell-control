{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "key": {
      "paddingLeft": 4,
      "width": 22
    },
    "size": {
      "binaryPrefix": "jedec",
      "maxPrefix": "GB",
      "ndigits": 1
    },
    "separator": "  ",
    "color": {
      "title": "cyan",
      "keys": "cyan"
    },
    "brightColor": false,
    "bar": {
      "color": {
        "total": "bright_black",
        "border": "green",
        "elapsed": "green"
      },
      "width": 36,
      "border": {
        "left": "",
        "right": ""
      },
      "char": {
        "elapsed": "█",
        "total": "█"
      }
    }
  },
  "modules": [
    "break",
    {
      "format": "  ┌─────────────────────────────────{#35} System {#}─────────────────────────────────┐",
      "type": "custom"
    },
    "break",
    {
      "key": "   Windows  ",
      "format": "{pretty-name} · {arch}",
      "type": "os",
      "keyColor": "35"
    },
    {
      "type": "kernel",
      "format": "{release}",
      "key": "     Build  ",
      "keyColor": "35"
    },
    {
      "key": "      BIOS  ",
      "format": "{version} · {type}",
      "type": "bios",
      "keyColor": "35"
    },
    {
      "key": "  Laufzeit  ",
      "format": "{days}d {hours}h {minutes}m",
      "type": "uptime",
      "keyColor": "35"
    },
    "break",
    {
      "format": "  ├────────────────────────────────{#36} Sitzung {#}─────────────────────────────────┤",
      "type": "custom"
    },
    "break",
    {
      "key": "     Shell  ",
      "format": "{pretty-name} {version}",
      "type": "shell",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": "  Terminal  ",
      "format": "{pretty-name} {version}",
      "keyColor": "36"
    },
    {
      "key": "   Schrift  ",
      "format": "Terminal-Profil wird gelesen",
      "type": "custom",
      "keyColor": "36"
    },
    "break",
    {
      "format": "  ├────────────────────────────────{#32} Hardware {#}────────────────────────────────┤",
      "type": "custom"
    },
    "break",
    {
      "key": "       CPU  ",
      "format": "{name} · {cores-physical}C/{cores-logical}T",
      "type": "cpu",
      "keyColor": "32"
    },
    {
      "key": "     Board  ",
      "format": "{name}",
      "type": "board",
      "keyColor": "32"
    },
    {
      "format": "{name} · {dedicated-total} · {temperature}",
      "temp": true,
      "type": "gpu",
      "key": "       GPU  ",
      "driverSpecific": true,
      "hideType": "integrated",
      "keyColor": "32"
    },
    {
      "type": "custom",
      "format": "Memory configuration",
      "key": "   RAM-Kit  ",
      "keyColor": "32"
    },
    {
      "key": "       RAM  ",
      "format": "{used} von {total} · {percentage}\n\u001b[22G{percentage-bar}",
      "type": "memory",
      "keyColor": "32",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "physicaldisk",
      "format": "{name} · {interconnect}",
      "key": "       SSD  ",
      "keyColor": "32"
    },
    {
      "key": "    SSD C:  ",
      "format": "{size-used} von {size-total} · {size-percentage}\n\u001b[22G{size-percentage-bar}",
      "folders": "C:\\",
      "type": "disk",
      "keyColor": "32",
      "percent": {
        "type": 3
      }
    },
    {
      "key": "   Monitor  ",
      "type": "display",
      "format": "{width}×{height} · {refresh-rate} Hz · {inch}\" · HDR {?hdr-enabled}an{?}{/hdr-enabled}aus{/}",
      "keyColor": "32"
    },
    "break",
    {
      "format": "  ├────────────────────────────────{#36} Netzwerk {#}────────────────────────────────┤",
      "type": "custom"
    },
    "break",
    {
      "type": "custom",
      "format": "__LAN_ADAPTER__",
      "key": " LAN-Karte  ",
      "keyColor": "36"
    },
    {
      "key": "       LAN  ",
      "format": "{ifname} · {ipv4} · {speed}",
      "defaultRouteOnly": true,
      "showSpeed": true,
      "type": "localip",
      "keyColor": "36"
    },
    {
      "format": "__WIFI_ADAPTER__",
      "key": "WLAN-Karte  ",
      "keyColor": "36",
      "type": "custom"
    },
    {
      "format": "{?ssid}{ssid} · Signal {signal-quality}{?}{/ssid}Nicht verbunden{/}",
      "key": "      WLAN  ",
      "keyColor": "36",
      "type": "wifi"
    },
    "break",
    {
      "type": "custom",
      "format": "  ├────────────────────────────────{#35} Medien {#}──────────────────────────────────┤"
    },
    "break",
    {
      "type": "bluetoothradio",
      "format": "{vendor} · Bluetooth {version}",
      "key": " Bluetooth  ",
      "keyColor": "35"
    },
    {
      "type": "sound",
      "format": "{name} · {volume-percentage}",
      "soundType": "main",
      "key": "     Audio  ",
      "keyColor": "35"
    },
    "break",
    {
      "format": "__HOST_FOOTER__",
      "type": "custom"
    },
    "break"
  ]
}